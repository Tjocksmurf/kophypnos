# Copy to .env for local development. Railway: set these as service variables (never commit real values).

NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
LOG_LEVEL=info

# Postgres (Railway injects DATABASE_URL from the Postgres plugin)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/kophypnos
DATABASE_SSL=0

# Random 32+ chars; signs the session cookie
SESSION_SECRET=change-me-to-a-long-random-string

# Twilio WhatsApp. Leave blank in dev to run in dry-run mode (codes/alerts are printed to the log).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Content template SIDs (HX...) once approved. Blank = send plain bodies (sandbox only).
TWILIO_TEMPLATE_LOGIN_CODE=
TWILIO_TEMPLATE_CHANGE_ALERT=
TWILIO_TEMPLATE_MONITOR_PROBLEM=
TWILIO_TEMPLATE_DIGEST=
TWILIO_TEMPLATE_ACCOUNT_DELETED=
WHATSAPP_DRY_RUN=1

# Anthropic — rule proposals, diff judging, relocation. Blank disables LLM features (manual rules still work).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
LLM_DAILY_CAP_USD=0.5

# Fetching / worker
FETCH_TIMEOUT_MS=15000
FETCH_MAX_BYTES=2097152
WORKER_CONCURRENCY=10
BROWSER_CONCURRENCY=2
WORKER_POLL_MS=30000

# Optional error reporting
SENTRY_DSN=
