{
  "name": "kophypnos",
  "version": "0.1.0",
  "private": true,
  "description": "Page Monitor — watch any web page for a change you describe, get a WhatsApp message when it happens",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/server.ts",
    "dev:worker": "dotenv -e .env -- tsx watch src/worker.ts",
    "dev:client": "npm --prefix client run dev",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.json",
    "build:client": "npm --prefix client ci && npm --prefix client run build",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "dotenv -e .env -- tsx src/migrate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/formbody": "^9.0.1",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^10.1.6",
    "@mozilla/readability": "^0.6.0",
    "cheerio": "^1.0.0",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.3.3",
    "fastify-plugin": "^6.0.1",
    "libphonenumber-js": "^1.12.8",
    "linkedom": "^0.18.10",
    "pg": "^8.23.1",
    "pino": "^9.7.0",
    "twilio": "^6.2.0",
    "zod": "^3.25.56"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/pg": "^8.23.1",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.0.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
